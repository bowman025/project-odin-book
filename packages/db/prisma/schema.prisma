generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid(2))
  email          String   @unique
  username       String   @unique
  passwordHash   String?
  githubId       String?  @unique
  refreshToken   String?
  profilePicture String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sentFollows     Follow[]      @relation("FollowSender")
  receivedFollows Follow[]      @relation("FollowReceiver")
  posts           Post[]
  likes           Like[]
  comments        Comment[]
  conversations   Participant[]
  messages        Message[]
}

model Follow {
  id         String       @id @default(cuid(2))
  senderId   String
  receiverId String
  status     FollowStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  sender   User @relation("FollowSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FollowReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId, status, createdAt(sort: Desc)])
  @@index([receiverId, status, createdAt(sort: Desc)])
}

model Post {
  id        String   @id @default(cuid(2))
  content   String
  imageUrl  String?
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  edited    Boolean  @default(false)

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags     Tag[]
  likes    Like[]
  comments Comment[]

  @@index([authorId, createdAt(sort: Desc)])
}

model Tag {
  id        String   @id @default(cuid(2))
  name      String   @unique
  createdAt DateTime @default(now())

  posts Post[]
}

model Like {
  id        String   @id @default(cuid(2))
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid(2))
  content   String
  authorId  String
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  edited    Boolean  @default(false)

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model Conversation {
  id        String   @id @default(cuid(2))
  hash      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants Participant[]
  messages     Message[]

  @@index([updatedAt(sort: Desc)])
}

model Participant {
  id             String   @id @default(cuid(2))
  userId         String
  conversationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id             String   @id @default(cuid(2))
  content        String
  senderId       String?
  conversationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  edited         Boolean  @default(false)

  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
}

enum FollowStatus {
  PENDING
  ACCEPTED
  REJECTED
}
