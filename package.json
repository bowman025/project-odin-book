{
  "name": "project-odin-book",
  "version": "1.0.0",
  "private": true,
  "description": "A social media app.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"server\",\"client\" -c \"cyan,green\" \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "pnpm --filter @project-odin-book/server dev",
    "dev:client": "pnpm --filter @project-odin-book/client dev",
    "format": "pnpm biome check --write .",
    "lint": "pnpm biome lint .",
    "test": "pnpm --filter @project-odin-book/server test",
    "build": "pnpm --recursive build",
    "db:push": "pnpm --filter @project-odin-book/db exec prisma db push",
    "db:seed": "pnpm --filter @project-odin-book/server run db:seed"
  },
  "keywords": [],
  "author": "Rastko Andonov",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.8.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "concurrently": "^10.0.3"
  }
}
